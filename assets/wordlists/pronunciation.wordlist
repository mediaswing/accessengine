# Pronunciation — general English
#
# Fixes for words that synthesisers routinely get wrong. The left side is what
# is written; the right side is a respelling of how it should sound.
#
# This file is yours to edit. It is copied into your settings folder on first
# run, and the app never overwrites it afterwards.

[pronounce]

# --- Abbreviations that should be read as words, not letters ---
#
# Write these WITHOUT their trailing full stop. A stop between two letters is
# part of the word ("e.g"), but the one at the end is punctuation, and leaving
# it on would make a rule that can never match.
e.g = for example
i.e = that is
etc = etcetera
vs = versus
approx = approximately
NB = note
RSVP = R S V P

# Titles such as "Dr." and "Prof." are deliberately absent: every back end
# already reads them correctly, and a rule here would leave the stop behind
# ("Doctor. Smith"), making the voice pause mid-name.

# --- British place names that trip up American voices ---
Gloucester = Gloster
Worcester = Wooster
Worcestershire = Wooster-sher
Leicester = Lester
Bicester = Bister
Towcester = Toaster
Greenwich = Grennitch
Norwich = Norritch
Warwick = Worrick
Berkeley = Barkley
Derby = Darby
Salisbury = Sawlsbry
Edinburgh = Edinbura
Loughborough = Luffbura
Slaithwaite = Slathwait
Belvoir = Beaver
Beaulieu = Bewley
Cholmondeley = Chumley
Featherstonehaugh = Fanshaw
Marylebone = Marlybone
Southwark = Sutherk
Holborn = Hoban
Magdalen = Maudlin
Alnwick = Annick
Keighley = Keithley
Frome = Froom
Shrewsbury = Shrowsbry
Hawarden = Harden
Ruthin = Rithin
Mousehole = Mowzel

