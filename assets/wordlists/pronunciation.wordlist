# --- Words voices commonly stress wrongly ---
awry = a rye
epitome = eh pit oh me
hyperbole = high per bo lee
segue = seg way
niche = neesh
quay = key
colonel = kernel
salmon = sammon
subtle = suttle
Wednesday = Wensday
February = Febyoo ary
